      "name": "local_recordings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_recordings\" (\"id\" TEXT NOT NULL, \"project_id\" TEXT NOT NULL, \"genre_id\" TEXT NOT NULL, \"subcategory_id\" TEXT NULL, \"title\" TEXT NULL, \"duration_seconds\" REAL NOT NULL DEFAULT 0.0, \"file_size_bytes\" INTEGER NOT NULL DEFAULT 0, \"format\" TEXT NOT NULL DEFAULT 'm4a', \"local_file_path\" TEXT NOT NULL, \"upload_status\" TEXT NOT NULL DEFAULT 'local', \"server_id\" TEXT NULL, \"gcs_url\" TEXT NULL, \"cleaning_status\" TEXT NOT NULL DEFAULT 'none', \"recorded_at\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"retry_count\" INTEGER NOT NULL DEFAULT 0, \"last_retry_at\" INTEGER NULL, \"register_id\" TEXT NULL, \"resumable_session_uri\" TEXT NULL, \"uploaded_bytes\" INTEGER NOT NULL DEFAULT 0, \"md5_hash\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
