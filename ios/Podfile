# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # Fix sqlite3 umbrella header: use angle-bracketed include instead of double-quoted
  umbrella = File.join(installer.sandbox.root, 'Target Support Files', 'sqlite3', 'sqlite3-umbrella.h')
  if File.exist?(umbrella)
    content = File.read(umbrella)
    fixed = content.gsub(/#import "sqlite3.h"/, '#import <sqlite3.h>')
    File.write(umbrella, fixed) if content != fixed
  end

  # Patch file_picker at its source (via the .symlinks plugin path, which
  # resolves to the pub cache). Two fixes:
  #   1. Rename FileUtils -> FPFileUtils to avoid runtime class collision
  #      with Apple's private OSAnalytics.framework (which also ships a
  #      class named "FileUtils").
  #   2. Silence the plugin's per-UTI NSLog output.
  file_picker_sources = File.join(
    File.dirname(__FILE__), '.symlinks', 'plugins', 'file_picker',
    'ios', 'file_picker', 'Sources', 'file_picker'
  )
  if Dir.exist?(file_picker_sources)
    Dir.glob(File.join(file_picker_sources, '**', '*.{m,h}')).each do |f|
      content = File.read(f)
      fixed = content
        .gsub(/\bFileUtils\b/, 'FPFileUtils')
        .gsub(/^\s*Log\(@"Custom file type supported:[^\n]*\n/, "\n")
        .gsub(/^\s*Log\(@"\[Skipping type\][^\n]*\n/, "\n")
      File.write(f, fixed) if content != fixed
    end
    # Umbrella header also references the old filename.
    umbrella_h = File.join(
      file_picker_sources, 'include', 'file_picker', 'file_picker-umbrella.h'
    )
    if File.exist?(umbrella_h)
      content = File.read(umbrella_h)
      fixed = content.gsub(/FileUtils\.h/, 'FPFileUtils.h')
      File.write(umbrella_h, fixed) if content != fixed
    end
    # Rename the .m/.h files themselves so the filenames match the class.
    [
      [File.join(file_picker_sources, 'FileUtils.m'),
       File.join(file_picker_sources, 'FPFileUtils.m')],
      [File.join(file_picker_sources, 'include', 'file_picker', 'FileUtils.h'),
       File.join(file_picker_sources, 'include', 'file_picker', 'FPFileUtils.h')],
    ].each do |src, dst|
      File.rename(src, dst) if File.exist?(src) && !File.exist?(dst)
    end
  end
end
